# Dual Database Configuration
DB_PROVIDER=hybrid

# 1. Cloud Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# 2. Local PostgreSQL Configuration
LOCAL_POSTGRES_HOST=localhost
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=your_password
LOCAL_POSTGRES_DB=elderguard_db
LOCAL_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/elderguard_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs & Services
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GROQ_API_KEYS=your_groq_api_keys
GROQ_MODEL=llama-3.1-8b-instant

# Notifications (FCM & Telegram)
FIREBASE_CREDENTIALS_JSON=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ElderGuardAIBot

# Demo only: escalate SOS tiers every N seconds instead of 2 / 5 / 10 minutes (0 = real timings)
SOS_DEMO_SECONDS=0
